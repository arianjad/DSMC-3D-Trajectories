# MICROTEST (3D) -- `fix emit/surf ... normal yes mflow` on a 5 mm stub
# venting into a vacuum box.  3D twin of in.mflow_stub.
# Requires mflow support, first tagged in the current 27Aug2026 solver.
#
# PRE-REGISTERED GATE, CAPM=diffuse (reflecting cap): the net flux
# (|fwd| - |rev|) at EVERY station equals Mdot within 1 %.  Nothing is
# absorbed upstream, so in steady state everything inserted must leave
# downstream, at all three stations alike.  Three stations 1.33 / 3.43 /
# 4.90 mm from the cap. run_stub3d.sh uses TWO independent seeds;
# compare their run means to assess run-to-run variation. The legacy
# analyzer's per-run frame SEM is not an independent-seed uncertainty.
#
# CAPM=vanish is report-only: it measures how far below Mdot an
# absorbing cap -- the one the mflow doc asks for -- leaves the
# delivered flow.
#
# mflow computes the inlet area itself from the surface geometry
# (doc/fix_emit_surf.txt), so the 48-gon cap's 0.29 % area deficit does
# NOT enter here; the prediction is 1.000 flat, unlike the fixed-nrho
# emit/surf gate in in.emitcap3d.
#
# GRID: the create_grid command below is authoritative: 140x56x56,
# h = 50 um. At the runner's fill density 3.2e22 and FNUM=1.715e9,
# initial full-cell occupancy is 2.33 simulation particles.
# The shipped surfaces were generated by gen3d_stub.py for a 70 um
# mesh; their intended mid-cell placement does not carry over here.
# Re-measure runtime and inspect diagnostics for the actual chosen mesh.
# This deck's conservation gate does not establish spatial convergence.
#
# Knobs: -var CAPM MFLOW NRHO FILLN FNUM DT STEPS SEED

seed        ${SEED}
units       si
dimension   3
boundary    o o o
global      gridcut 0.0
create_box  0.0 0.007 -0.0014 0.0014 -0.0014 0.0014
create_grid 140 56 56
global      mem/limit 1024
balance_grid rcb cell

species     he.species He
mixture     hegas He nrho ${NRHO} temp 4.0
mixture     fillgas He nrho ${FILLN} temp 4.0
global      fnum ${FNUM}
collide     vss hegas he.vss

read_surf   stub3d.surf type group stub clip
surf_collide walls diffuse 4.0 1.0
surf_modify stub collide walls

surf_collide tp transparent
read_surf   s1_fwd3d.surf type transparent group s1f
surf_modify s1f collide tp
read_surf   s1_rev3d.surf type transparent group s1r
surf_modify s1r collide tp
read_surf   s3_fwd3d.surf type transparent group s3f
surf_modify s3f collide tp
read_surf   s3_rev3d.surf type transparent group s3r
surf_modify s3r collide tp
read_surf   s2_fwd3d.surf type transparent group s2f
surf_modify s2f collide tp
read_surf   s2_rev3d.surf type transparent group s2r
surf_modify s2r collide tp

group       cap surf type 2
if "${CAPM} == vanish" then "surf_collide capm vanish" &
   else "surf_collide capm diffuse 4.0 1.0"
surf_modify cap collide capm

region      borevol cylinder x 0 0 0.000825 0.000075 0.005075
create_particles fillgas n 0 region borevol
balance_grid rcb part
fix         bal balance 5000 1.1 rcb time

fix         src emit/surf hegas cap normal yes mflow ${MFLOW} 4.0

compute     c1f surf s1f hegas nflux norm flow
fix         a1f ave/surf s1f 10 100 1000 c_c1f[1]
dump        d1f surf s1f 1000 s1f.out id f_a1f
compute     c1r surf s1r hegas nflux norm flow
fix         a1r ave/surf s1r 10 100 1000 c_c1r[1]
dump        d1r surf s1r 1000 s1r.out id f_a1r
compute     c3f surf s3f hegas nflux norm flow
fix         a3f ave/surf s3f 10 100 1000 c_c3f[1]
dump        d3f surf s3f 1000 s3f.out id f_a3f
compute     c3r surf s3r hegas nflux norm flow
fix         a3r ave/surf s3r 10 100 1000 c_c3r[1]
dump        d3r surf s3r 1000 s3r.out id f_a3r
compute     c2f surf s2f hegas nflux norm flow
fix         a2f ave/surf s2f 10 100 1000 c_c2f[1]
dump        d2f surf s2f 1000 s2f.out id f_a2f
compute     c2r surf s2r hegas nflux norm flow
fix         a2r ave/surf s2r 10 100 1000 c_c2r[1]
dump        d2r surf s2r 1000 s2r.out id f_a2r

stats       2000
stats_style step cpu np nattempt ncoll f_src[1] f_src[2]
stats_modify flush yes
timestep    ${DT}
run         ${STEPS}
